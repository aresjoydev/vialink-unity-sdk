<?xml version="1.0" encoding="utf-8"?>
<!--
  ViaLink Unity SDK link.xml

  Unity Managed Stripping 으로부터 SDK 가 의존하는 Unity API 들을 보호한다.
  특히 UnityWebRequest.Result 같은 nested enum 은 stripper 가 unused 로 판단해
  제거하는 경우가 있어 IL2CPP 빌드 시 "Unresolved type reference" 에러를 유발한다.

  link.xml 은 UPM 패키지의 Runtime/ 폴더에 두면 Unity 가 자동으로 적용한다.
-->
<linker>
  <!-- UnityWebRequest 와 nested types (Result 포함) 보호 -->
  <assembly fullname="UnityEngine.UnityWebRequestModule">
    <type fullname="UnityEngine.Networking.UnityWebRequest" preserve="all"/>
    <type fullname="UnityEngine.Networking.UnityWebRequestAsyncOperation" preserve="all"/>
    <type fullname="UnityEngine.Networking.UploadHandler" preserve="all"/>
    <type fullname="UnityEngine.Networking.UploadHandlerRaw" preserve="all"/>
    <type fullname="UnityEngine.Networking.DownloadHandler" preserve="all"/>
    <type fullname="UnityEngine.Networking.DownloadHandlerBuffer" preserve="all"/>
  </assembly>

  <!-- SDK 자체도 reflection / RuntimeInitializeOnLoadMethod 사용을 위해 전체 보호 -->
  <assembly fullname="ViaLinkSDK" preserve="all"/>

  <!--
    asmdef 로 만들어지는 ViaLink 어셈블리(=Runtime/ViaLink.asmdef)도 보호.
    ViaLinkBootstrap 은 외부 참조가 0 인 internal static class 라서
    IL2CPP managed stripping 이 "도달 불가"로 판단해 통째로 제거할 수 있다.
    그러면 BeforeSceneLoad 에서 ViaLinkSDK GameObject 가 생성되지 않아
    사용자 코드의 ViaLinkSDK.Instance 가 null 이 된다.
  -->
  <assembly fullname="ViaLink" preserve="all"/>
</linker>
